# PlayStation VR2 (USB 054c:0cde) — grant the active session access to the
# IIO (IMU) and input (buttons/proximity/IPD) nodes created by the psvr2 module.
SUBSYSTEM=="iio", KERNELS=="*", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0cde", TAG+="uaccess"
# The headset INS reads every 2 kHz IMU sample through the IIO buffer
# (libpsvr2 psvr2_imu_stream_open); let the session user switch it on.
SUBSYSTEM=="iio", ACTION=="add", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0cde", RUN+="/bin/sh -c 'chmod 0666 /sys%p/buffer/enable /sys%p/buffer/length /sys%p/scan_elements/*_en'"
SUBSYSTEM=="input", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0cde", TAG+="uaccess"
# pose / gaze char devices (miscdevices). These have no USB ancestry in sysfs and
# are not assigned to a seat, so logind never applies a "uaccess" ACL to them —
# uaccess silently does nothing here. Grant access via group instead: "input" is
# present on all systemd systems and is the conventional local-device group.
# (Add yourself once with: sudo usermod -aG input "$USER"  then re-login.)
SUBSYSTEM=="misc", KERNEL=="psvr2-pose", MODE="0660", GROUP="input"
SUBSYSTEM=="misc", KERNEL=="psvr2-gaze", MODE="0660", GROUP="input"
# control reports + clock map, LED-detector and relocaliser streams
SUBSYSTEM=="misc", KERNEL=="psvr2-ctrl", MODE="0660", GROUP="input"
SUBSYSTEM=="misc", KERNEL=="psvr2-ld", MODE="0660", GROUP="input"
SUBSYSTEM=="misc", KERNEL=="psvr2-rp", MODE="0660", GROUP="input"
# V4L2 camera node
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0cde", TAG+="uaccess"
# brightness / rumble / see-through / EDID type sysfs attributes, writable by
# the "input" group (the SteamVR driver sets them).
ACTION=="bind", SUBSYSTEM=="usb", DRIVER=="psvr2", RUN+="/bin/sh -c 'cd /sys%p && chgrp input brightness rumble see_through edid_type && chmod g+w brightness rumble see_through edid_type'"
# PS VR2 Sense controllers (054c:0e45 left, 0e46 right): hidraw for the SteamVR
# driver, over USB and Bluetooth. Group, not uaccess: this file sorts after
# 73-seat-late.rules, so a uaccess tag set here never becomes an ACL.
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0e45|0e46", MODE="0660", GROUP="input"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", KERNELS=="0005:054C:0E45.*|0005:054C:0E46.*", MODE="0660", GROUP="input"
