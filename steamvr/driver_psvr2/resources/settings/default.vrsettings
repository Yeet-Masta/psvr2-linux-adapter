{
	"driver_psvr2": {
		"enable": true,
		"model_number": "PSVR2",
		"serial_number": "PSVR2-0001",

		"//hz": "Panel refresh when SteamVR has no preferred rate of its own. SteamVR's",
		"//hz2": "Video > Refresh Rate setting wins; 90 or 120 (restart SteamVR after changing).",
		"display_frequency": 90.0,

		"//direct": "true (default): report the panel as a real, non-desktop display",
		"//direct2": "so SteamVR's compositor acquires it directly via DRM leasing (no",
		"//direct3": "TTY; desktop keeps running). false: extended-desktop scaffold,",
		"//direct4": "which needs the window_* placement below. See docs/steamvr.md.",
		"direct_mode": true,

		"//": "Extended-mode (direct_mode=false) panel placement. window_* describe",
		"//x": "where the 4000x2040 panel sits in the X/desktop layout; set window_x",
		"//xx": "to the panel's left edge (e.g. primary-monitor width). Ignored in direct mode.",
		"window_x": 0,
		"window_y": 0,
		"window_width": 4000,
		"window_height": 2040,

		"//haptics": "true: play SteamVR haptics as PCM on the Sense voice-coil actuators",
		"//haptics2": "(richer, like PSVR2 Toolkit's enhanced haptics). false: classic rumble.",
		"enhanced_haptics": true,

		"//ipc": "Serve PSVR2 Toolkit's IPC (127.0.0.1:3364) so Toolkit-aware apps get",
		"//ipc2": "eye tracking and adaptive triggers. Turn off if you run PSVR2 Toolkit itself.",
		"toolkit_ipc": true,

		"//trigger": "Adaptive trigger feel when no Toolkit-aware app is driving it:",
		"//trigger2": "off | light | medium | heavy (resistance) | click (two-stage) | rigid.",
		"default_trigger_effect": "light",

		"//predict": "How far ahead (ms) SteamVR extrapolates controller motion to hide",
		"//predict2": "Bluetooth latency. 0 disables; above ~20 overshoots on fast flicks.",
		"controller_prediction_ms": 12.0,

		"//wear": "Recenter controller heading when you put the headset on and next",
		"//wear2": "hold the controllers level and still in front of you.",
		"recenter_on_wear": true,

		"//alerts": "Controller buzz at 15 % / 5 % battery, headset rumble on disconnect.",
		"controller_alerts": true,

		"//height": "Metres added to the headset height. Leave 0 if you ran SteamVR room",
		"//height2": "setup; set ~your eye height if the view starts at floor level.",
		"standing_height_m": 0.0,

		"//ins": "Sony's headset INS: carry the SLAM pose forward with the 2 kHz IMU to",
		"//ins2": "the present (needs the IIO buffer rule from 99-psvr2.rules).",
		"headset_ins": true,

		"//camera": "Expose the tracking cameras to SteamVR (Room View / passthrough).",
		"passthrough_camera": true,

		"//chaperone": "Write a 1.5 m circle play area at the first tracked pose when",
		"//chaperone2": "SteamVR has none for this headset.",
		"provide_chaperone": true,

		"//vib": "Sony's vibration strength: 0 off, 1 normal, 2 weak, 3 weakest.",
		"vibration_strength": 1,

		"//btframe": "Bluetooth output framing: true = Sony's (31 a2), false = DualSense-style.",
		"sony_bt_framing": true,

		"//poll": "Send the PC polling-rate feature report (Sony's driver never does).",
		"set_polling_rate": false,

		"//optical": "EXPERIMENTAL: sync the controller LEDs to the headset cameras",
		"//optical2": "(LED sync only; no optical pose yet). Needs the dev kernel module.",
		"optical_tracking": false,
		"optical_log_blobs": false,
		"optical_trace": false,

		"//ukf": "Fuse optical fixes with the controller IMU (docs/sony-re/ukf.md); false = raw optical position.",
		"//ukf2": "hold_ms: hold the last fix position once fixes are this old (Sony 300). sigma floors in mm.",
		"//broaddiv": "BROAD code frame divider: 1 = Sony (one code frame per LD frame), 3 = every third LD frame.",
		"//broaddiv2": "Both are decoded and logged ('ledsync: BROAD decodes'); this picks the one acted on.",
		"optical_broad_divider": 1,

		"//sonymatch": "LED-blob matching: true = Sony's three-pass match with neighbour support",
		"//sonymatch2": "(FUN_1800df5b0), false = our image-shift consensus (better when few LEDs show).",
		"optical_sony_match": true,
		"//sonystates": "true = Sony's close-range (< 170 mm from a camera) and image-edge track states",
		"//sonystates2": "(FUN_1800db690); false = the normal track step everywhere.",
		"optical_sony_states": true,
		"//edgestate": "Sony's edge state (<= 3 LEDs predicted inside the images); less accurate in simulation.",
		"optical_edge_state": true,
		"//ransacboot": "true = boot first with Sony's RANSAC (FUN_1800c2960; no heading needed, gravity from the IMU),",
		"//ransacboot2": "then the heading sweep if it finds nothing; false = heading sweep only.",
		"optical_ransac_boot": true,

		"optical_ukf": true,
		"optical_ukf_hold_ms": 300,
		"optical_ukf_rot_sigma_mm": 1.0,
		"optical_ukf_pos_sigma_mm": 0.0
	}
}
