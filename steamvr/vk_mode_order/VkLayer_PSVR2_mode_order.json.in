{
    "file_format_version": "1.1.2",
    "layer": {
        "name": "VK_LAYER_PSVR2_mode_order",
        "type": "INSTANCE",
        "library_path": "@LIB@",
        "api_version": "1.4.0",
        "implementation_version": "1",
        "description": "PSVR2: list HMD display modes in ascending refresh so vrcompositor uses the 119.88 Hz rate",
        "functions": {
            "vkNegotiateLoaderLayerInterfaceVersion": "vkNegotiateLoaderLayerInterfaceVersion"
        },
        "enable_environment": { "_STEAMVR_LOGGING_READY": "1" },
        "disable_environment": { "PSVR2_VK_MODE_ORDER_DISABLE": "1" }
    }
}
